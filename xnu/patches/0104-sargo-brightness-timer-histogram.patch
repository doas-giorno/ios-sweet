+/* Software brightness: scale each colour channel by f/256 (the OLED has no backlight to dim). */
+static inline uint32_t
+sweet_dim(uint32_t p, uint32_t f)
+{
+	uint32_t rb = (((p & 0x00ff00ffu) * f) >> 8) & 0x00ff00ffu;
+	uint32_t g = ((((p >> 8) & 0xffu) * f) >> 8) & 0xffu;
+	return 0xff000000u | rb | (g << 8);
+}
+
 /* The kernel memcmp is a slow byte loop (about 250 MB/s here): compare 64 bytes per step instead. */
