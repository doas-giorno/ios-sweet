+#define STMR_N 1024
+static volatile uint64_t stmr_key[STMR_N];
+static volatile uint32_t stmr_cnt[STMR_N];
+
+void
+sweet_timer_func_sample(uintptr_t func)
+{
+	if (!sprof_on) {
+		return;
+	}
+	uint64_t k = (uint64_t)func;
+	unsigned i = (unsigned)((k * 0x9E3779B97F4A7C15ull) >> (64 - 10));
+	for (unsigned probe = 0; probe < 32; probe++, i = (i + 1) & (STMR_N - 1)) {
+		uint64_t cur = stmr_key[i];
+		if (cur == 0 && OSCompareAndSwap64(0, k, (volatile UInt64 *)&stmr_key[i])) {
+			cur = k;
+		}
+		if (cur == k || stmr_key[i] == k) {
+			OSIncrementAtomic((volatile SInt32 *)&stmr_cnt[i]);
+			return;
+		}
+	}
+}
+
+static void
+sprof_dump_timers(void)
+{
+	for (unsigned r = 0; r < 12; r++) {
+		uint32_t best = 0;
+		unsigned bi = 0;
+		for (unsigned i = 0; i < STMR_N; i++) {
+			if (stmr_cnt[i] > best) {
+				best = stmr_cnt[i];
+				bi = i;
+			}
+		}
+		if (best == 0) {
+			break;
+		}
+		printf("SWEET PROF: timer callout #%u func 0x%llx n %u\n", r, (unsigned long long)stmr_key[bi], best);
+		stmr_cnt[bi] = 0;
+	}
+	for (unsigned i = 0; i < STMR_N; i++) {
+		stmr_cnt[i] = 0;
+		stmr_key[i] = 0;
+	}
+}
+
 void
 sweet_prof_dump(unsigned top)
 {
 	uint32_t total = 0;
+	sprof_dump_timers();
 	for (unsigned i = 0; i < SPROF_N; i++) {
 		total += sprof_cnt[i];
 	}
