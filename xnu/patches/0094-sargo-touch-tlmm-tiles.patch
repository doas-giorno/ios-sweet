 	uint16_t rmi_data;
@@ -152,19 +154,26 @@ touch_wait_clear(vm_offset_t base, uint32_t off, uint32_t mask)
 	return false;
 }
 
+static vm_offset_t
+touch_base(unsigned pin)
+{
+	return (st.sargo && pin == SARGO_SWITCH) ? st.gpio_w : st.gpio;
+}
+
 static void
 touch_gpio(unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out, bool high)
 {
+	vm_offset_t b = touch_base(pin);
 	uint32_t off = TOUCH_GPIO_CFG(pin);
-	uint32_t cfg = touch_rd(st.gpio, off);
+	uint32_t cfg = touch_rd(b, off);
 	if (out) {
 		/* Set the desired latch before enabling output (reset is active low). */
-		touch_wr(st.gpio, TOUCH_GPIO_IO(pin),
-		    (touch_rd(st.gpio, TOUCH_GPIO_IO(pin)) & ~2u) | (high ? 2u : 0u));
+		touch_wr(b, TOUCH_GPIO_IO(pin),
+		    (touch_rd(b, TOUCH_GPIO_IO(pin)) & ~2u) | (high ? 2u : 0u));
 	}
 	cfg &= ~0x3ffu;
 	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
-	touch_wr(st.gpio, off, cfg);
+	touch_wr(b, off, cfg);
 }
 
 static bool
