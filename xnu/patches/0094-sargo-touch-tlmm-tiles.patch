-#define SARGO_TLMM_PA    0x03400000u
+/* SDM670 TLMM is tiled (pinctrl-sdm670.c): pin n at tile + 0x1000 * n; NORTH=0x500000, WEST=0x100000 from 0x3400000 */
+#define SARGO_TLMM_PA    0x03900000u    /* NORTH: gpio6, gpio7, gpio99, gpio125 */
+#define SARGO_WEST_PA    0x03500000u    /* WEST: gpio135 */
 #define SARGO_TLMM_SIZE  0x90000u
 #define SARGO_RST        99u
 #define SARGO_IRQ        125u
