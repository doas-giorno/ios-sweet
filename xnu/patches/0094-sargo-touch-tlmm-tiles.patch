@@ -34,7 +34,9 @@ void sweet_touch_init(void);
 /* Pixel 3a (sargo): same SE (a84000 = QUP wrapper1 S1, SDA/SCL gpio6/7), Synaptics
  * RMI4 at 0x20, SDM670 TLMM at 0x3400000 (pin n at n*0x1000), reset gpio99 (active
