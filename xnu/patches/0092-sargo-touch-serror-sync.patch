+/*
+ * Pixel 3a bring-up: a posted MMIO error is reported as an SError that stays pending
+ * (PSTATE.A is masked in the kernel) until the thread is next scheduled, so the panic
+ * names the wrong place. Briefly unmask it and wait for the access to complete, so
+ * the fault lands right after the offending register access.
+ */
+static inline void
+touch_sync(void)
+{
+	if (st.sargo) {
+		__asm__ volatile("msr daifclr, #4\n\tdsb sy\n\tisb\n\tmsr daifset, #4" ::: "memory");
+	}
+}
+
 static uint32_t
 touch_rd(vm_offset_t base, uint32_t off)
 {
 	uint32_t v = *(volatile uint32_t *)(base + off);
 	__asm__ volatile("dmb oshld" ::: "memory");
+	touch_sync();
 	return v;
 }
 
