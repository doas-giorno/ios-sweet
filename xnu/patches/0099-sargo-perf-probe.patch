diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
index fe26ca9..a1993de 100644
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -946,6 +946,38 @@ out:
 	thread_block(THREAD_CONTINUE_NULL);
 }
 
+/* CPU speed probe: 8 threads each time a dependent add loop; the iterations per microsecond show the core speed. */
+static void
+perf_thread(void *arg, wait_result_t result)
+{
+	uint64_t n = 400000000ull, x = 0, t0, t1, ns = 0, id = (uint64_t)(uintptr_t)arg;
+	(void)result;
+	touch_wait(20000);
+	t0 = mach_absolute_time();
+	for (uint64_t i = 0; i < n; i++) {
+		__asm__ volatile("add %0, %0, #1" : "+r"(x));
+	}
+	t1 = mach_absolute_time();
+	absolutetime_to_nanoseconds(t1 - t0, &ns);
+	printf("SWEET PERF: probe %llu: %llu iterations in %llu ms = %llu Miter/s\n",
+	    id, n, ns / 1000000, ns ? n * 1000 / ns : 0);
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_perf_probe(void)
+{
+	int on = 1;
+	(void)PE_parse_boot_argn("sweetperf", &on, sizeof(on));
+	for (uintptr_t i = 0; on && i < 8; i++) {
+		thread_t th;
+		if (kernel_thread_start(perf_thread, (void *)i, &th) == KERN_SUCCESS) {
+			thread_deallocate(th);
+		}
+	}
+}
+
 void
 sweet_touch_init(void)
 {
