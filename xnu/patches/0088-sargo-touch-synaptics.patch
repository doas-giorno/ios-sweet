 	st.se = ml_io_map(TOUCH_SE_PA, 0x4000);
 	if (!st.gcc || !st.gpio || !st.se) {
 		printf("SWEET TOUCH: MMIO mapping failed\n");
@@ -569,6 +748,41 @@ touch_thread(void *arg, wait_result_t result)
 	if (!touch_clocks() || !touch_se_init()) {
 		goto out;
 	}
+	if (st.sargo) {
+		sargo_power_report();
+		printf("SWEET TOUCH: sargo TLMM reset=%#x irq=%#x switch=%#x\n",
+		    touch_rd(st.gpio, TOUCH_GPIO_IO(SARGO_RST)), touch_rd(st.gpio, TOUCH_GPIO_IO(SARGO_IRQ)),
+		    touch_rd(st.gpio, TOUCH_GPIO_IO(SARGO_SWITCH)));
+		touch_gpio(SARGO_IRQ, 0, 0, 2, false, false);   /* input, no pull */
+		touch_gpio(SARGO_SWITCH, 0, 0, 2, true, false); /* output low */
+		touch_gpio(SARGO_RST, 0, 0, 2, true, false);    /* hold in reset */
+		touch_gpio(6, 1, 0, 0, false, false);           /* qup9 SDA/SCL */
+		touch_gpio(7, 1, 0, 0, false, false);
+		touch_wait(20);
+		touch_gpio(SARGO_RST, 0, 0, 2, true, true);     /* release (vendor: 1 ms low, 20 ms) */
+		touch_wait(300);
+		st.probing = true;
+		int rerr = touch_rmi_probe();
+		st.probing = false;
+		printf("SWEET TOUCH: rmi probe err=%d\n", rerr);
+		if (rerr) {
+			goto out;
+		}
+		st.kind = TOUCH_RMI;
+		unsigned errors = 0;
+		printf("SWEET TOUCH: Synaptics RMI4 polling, 1080x2220\n");
+		while (!st.dead) {
+			int err = touch_rmi();
+			if (err && (errors++ % 100u) == 0) {
+				printf("SWEET TOUCH: rmi report err=%d\n", err);
+			} else if (!err) {
+				errors = 0;
+			}
+			touch_wait(10);
+		}
+		touch_report(0, st.x, st.y);
+		goto out;
+	}
 	printf("SWEET TOUCH: TLMM reset=%#x irq=%#x vdd90=%#x; voting L11C through RPMh\n",
 	    touch_rd(st.gpio, TOUCH_GPIO_IO(8)), touch_rd(st.gpio, TOUCH_GPIO_IO(9)),
 	    touch_rd(st.gpio, TOUCH_GPIO_IO(90)));
