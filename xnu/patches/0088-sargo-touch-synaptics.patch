+/* PMIC arbiter observer read (read only; same access as sweet_keys.c). */
+static uint16_t
+sp_find_apid(uint16_t ppid, uint32_t count)
+{
+	uint16_t found = 0xffffu;
+	for (uint32_t i = 0; i < count; ++i) {
+		uint32_t map = touch_rd(st.sp_core, 0x900u + 4u * i);
+		if (map == 0 || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		uint32_t owner = touch_rd(st.sp_cnfg, 0x700u + 4u * i) & 7u;
+		if (found == 0xffffu || owner == 0) {
+			found = (uint16_t)i;
+		}
+	}
+	return found;
+}
+
+static bool
+sp_read(uint16_t apid, uint16_t addr, uint8_t *out)
+{
+	if (apid == 0xffffu) {
+		return false;
+	}
+	uint32_t off = 0x80u * apid;
+	*(volatile uint32_t *)(st.sp_obs + off) = (1u << 27) | ((uint32_t)(addr & 0xffu) << 4);
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = touch_rd(st.sp_obs, off + 0x08u);
+		if (status & 1u) {
+			if (status & 0x0eu) {
+				return false;
+			}
+			*out = (uint8_t)touch_rd(st.sp_obs, off + 0x18u);
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/* Is the touch power switch (PM660 GPIO12) already on? Never writes. */
+static void
+sargo_power_report(void)
+{
+	st.sp_core = ml_io_map(SP_CORE_PA, 0x2000);
+	st.sp_cnfg = ml_io_map(SP_CNFG_PA, 0x1000);
+	st.sp_obs = ml_io_map(SP_OBS_PA, 0x10000);
+	if (!st.sp_core || !st.sp_cnfg || !st.sp_obs) {
+		printf("SWEET TOUCH: SPMI mapping failed\n");
+		return;
+	}
+	uint32_t ver = touch_rd(st.sp_core, 0), count = touch_rd(st.sp_core, 4) & 0x7ffu;
+	if (count == 0 || count > 512) {
+		printf("SWEET TOUCH: SPMI arbiter version=%#x apids=%u unsupported\n", ver, count);
+		return;
+	}
+	uint16_t apid = sp_find_apid(0x0cb, count);
+	uint8_t mode = 0, en = 0, sub = 0, rt = 0;
+	bool a = sp_read(apid, 0xcb40, &mode), b = sp_read(apid, 0xcb46, &en);
+	bool c = sp_read(apid, 0xcb05, &sub), d = sp_read(apid, 0xcb10, &rt);
+	printf("SWEET TOUCH: pm660 gpio12 arb=%#x apids=%u apid=%u mode=%#x/%d en=%#x/%d subtype=%#x/%d rt=%#x/%d\n",
+	    ver, count, apid, mode, a, en, b, sub, c, rt, d);
+}
+
+static void
+touch_dump(const char *what, uint16_t reg, const uint8_t *b, unsigned n)
+{
+	for (unsigned off = 0; off < n; off += 16) {
+		char line[49];
+		unsigned m = n - off < 16 ? n - off : 16;
+		for (unsigned j = 0; j < m; ++j) {
+			(void)snprintf(line + j * 3u, 4, "%02x ", b[off + j]);
+		}
+		printf("SWEET TOUCH: %s %#x: %s\n", what, reg + off, line);
+	}
+}
+
+/*
+ * Synaptics RMI4 (page 0): scan the function descriptor table, set F01 to
+ * normal/configured, then poll F12 finger data (8 bytes per finger:
+ * type, x lo/hi, y lo/hi, z, wx, wy). The F12 data offset is assumed to be 0;
+ * the first touches are dumped so the layout can be confirmed.
+ */
+static int
+touch_rmi_probe(void)
+{
+	uint8_t page = 0, pdt[6], f01_ctrl = 0, f01_data = 0;
+	uint16_t f01_c = 0, f01_d = 0, f12_q = 0, f12_d = 0;
+	int err = touch_msg(SARGO_RMI, (const uint8_t[]){0xff, page}, 2, NULL, 0, false);
+	if (err) {
+		return err;
+	}
+	for (uint16_t a = 0xe9; a > 0xd0; a -= 6) {
+		err = touch_read(SARGO_RMI, a, false, pdt, 6);
+		if (err) {
+			return err;
+		}
+		touch_dump("pdt", a, pdt, 6);
+		if (pdt[5] == 0) {
+			break;
+		}
+		if (pdt[5] == 0x01) {
+			f01_c = pdt[2];
+			f01_d = pdt[3];
+		} else if (pdt[5] == 0x12) {
+			f12_q = pdt[0];
+			f12_d = pdt[3];
+		}
+	}
+	printf("SWEET TOUCH: rmi f01 ctrl=%#x data=%#x f12 query=%#x data=%#x\n", f01_c, f01_d, f12_q, f12_d);
+	if (!f01_d || !f12_d) {
+		return ENODEV;
+	}
+	(void)touch_read(SARGO_RMI, f01_d, false, &f01_data, 1);
+	(void)touch_read(SARGO_RMI, f01_c, false, &f01_ctrl, 1);
+	printf("SWEET TOUCH: rmi f01 status=%#x ctrl0=%#x\n", f01_data, f01_ctrl);
+	uint8_t q[16];
+	if (!touch_read(SARGO_RMI, f12_q, false, q, sizeof(q))) {
+		touch_dump("f12 query", f12_q, q, sizeof(q));
+	}
+	const uint8_t cfg[2] = {(uint8_t)f01_c, (uint8_t)((f01_ctrl & ~3u) | 0x84u)};
+	(void)touch_msg(SARGO_RMI, cfg, 2, NULL, 0, false);
+	st.rmi_data = f12_d;
+	return 0;
+}
+
+static int
+touch_rmi(void)
+{
+	uint8_t buf[8 * TOUCH_MAX];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+	int err = touch_read(SARGO_RMI, st.rmi_data, false, buf, sizeof(buf));
+	if (err) {
+		return err;
+	}
+	for (unsigned i = 0; i < TOUCH_MAX; ++i) {
+		const uint8_t *p = buf + 8u * i;
+		if (p[0] != 1u && p[0] != 2u) {
+			continue;
+		}
+		unsigned px = p[1] | ((unsigned)p[2] << 8), py = p[3] | ((unsigned)p[4] << 8);
+		if (px > 1079 || py > 2219) {
+			continue;
+		}
+		mask |= 1u << i;
+		x[i] = (int)px;
+		y[i] = (int)py;
+	}
+	if ((mask || st.active) && st.rmi_dumps < 12) {
+		++st.rmi_dumps;
+		touch_dump("f12 data", st.rmi_data, buf, 24);
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
+
 static bool
