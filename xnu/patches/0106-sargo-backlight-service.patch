diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index a125519..fd22633 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -83,6 +83,31 @@ enum {
 #define SWEET_FB_LOGICAL_H              2436
 #define SWEET_FB_FORMAT_BGRA            0x42475241
 
+/*
+ * iOS's AppleARMBacklight stand-in. backboardd looks for an IOService with the property
+ * backlight-control (and the /backlight device-tree node): without it iOS decides the phone has no
+ * brightness control. The brightness itself is applied by the panel copy (sweet_dim).
+ */
+class SweetBacklight : public IOService {
+	OSDeclareDefaultStructors(SweetBacklight);
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetBacklight, IOService);
+
+bool
+SweetBacklight::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty("backlight-control", kOSBooleanTrue);
+	registerService();
+	IOLog("SWEET BL: backlight service published (backlight-control)\n");
+	return true;
+}
+
 class IOMobileFramebuffer : public IOService {
 	OSDeclareDefaultStructors(IOMobileFramebuffer);
 };
