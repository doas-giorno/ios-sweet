 extern "C" uint64_t mach_absolute_time(void);
+
+/* The kernel memcmp is a slow byte loop (about 250 MB/s here): compare 64 bytes per step instead. */
+typedef uint64_t __attribute__((aligned(1), may_alias)) sweet_u64u;
+typedef uint32_t __attribute__((aligned(1), may_alias)) sweet_u32u;
+
+static inline bool
+sweet_rows_equal(const void *a, const void *b, size_t n)
+{
+	const sweet_u64u *x = (const sweet_u64u *)a, *y = (const sweet_u64u *)b;
+	size_t q = n / 8, i = 0;
+	for (; i + 8 <= q; i += 8) {
+		uint64_t d = (x[i] ^ y[i]) | (x[i + 1] ^ y[i + 1]) | (x[i + 2] ^ y[i + 2]) | (x[i + 3] ^ y[i + 3]) |
+		    (x[i + 4] ^ y[i + 4]) | (x[i + 5] ^ y[i + 5]) | (x[i + 6] ^ y[i + 6]) | (x[i + 7] ^ y[i + 7]);
+		if (d) {
+			return false;
+		}
+	}
+	for (; i < q; i++) {
+		if (x[i] != y[i]) {
+			return false;
+		}
+	}
+	if (n & 4) {
+		if (*(const sweet_u32u *)((const uint8_t *)a + q * 8) != *(const sweet_u32u *)((const uint8_t *)b + q * 8)) {
+			return false;
+		}
+	}
+	return true;
+}
