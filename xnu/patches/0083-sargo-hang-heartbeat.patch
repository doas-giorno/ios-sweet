diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 670a4d1..26d9802 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -1168,4 +1168,46 @@ sweet_ufs_rootdev(dev_t *dev)
 	*dev = su.bdev;
 	return 0;
 }
+/*
+ * Hang diagnostics (boot-arg sweethb=1): a heartbeat thread started by AppleCLCD that prints
+ * a line every second and, at ticks 5 and 12, every thread's state and wait event (raw
+ * kernel addresses plus the kernel slide: symbolise offline with the unstripped kernel).
+ * No heartbeat = no scheduling/timer interrupts; heartbeat but no progress = see the dump.
+ */
+extern vm_offset_t vm_kernel_slide;
+extern void sweet_thread_dump(void);    /* osfmk/kern/thread.c: struct thread is opaque here */
+
+static void
+sweet_hb_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t sec;
+	nanoseconds_to_absolutetime(NSEC_PER_SEC, &sec);
+	for (uint32_t n = 1;; n++) {
+		uint64_t until = mach_absolute_time() + sec;
+		while (mach_absolute_time() < until) {
+		}
+		if (n <= 4 || n % 60 == 0) {
+			printf("SWEET HB %u: t=%llu\n", n, mach_absolute_time());
+		}
+		if (n == 5 || n == 12) {
+			printf("SWEET HB: slide 0x%lx\n", (unsigned long)vm_kernel_slide);
+			sweet_thread_dump();
+		}
+	}
+}
+
+void sweet_hb_start(void);
+
+void
+sweet_hb_start(void)
+{
+	uint32_t on = 0;
+	thread_t thread;
+
+	PE_parse_boot_argn("sweethb", &on, sizeof(on));
+	if (on && kernel_thread_start(sweet_hb_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
 #endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
