@@ -37,6 +37,7 @@
 #include "SweetSurface.h"
 
 extern "C" int sweet_console_muted;     /* osfmk/console/serial_console.c */
+extern "C" void sweet_hb_start(void);     /* bsd/dev/sweet_ufs.c: hang diagnostics, boot-arg sweethb=1 */
 
 #if defined(SWEET)
 #include <IOKit/IOService.h>
@@ -203,6 +204,7 @@ AppleCLCD::start(IOService *provider)
 	registerService();
 	IOLog("SWEET FB: AppleCLCD %ux%u stride %u at 0x%llx, default surface %u, presented as %ux%u\n",
 	    fWidth, fHeight, fRowBytes, fPhys, fSurface->id, fLogicalW, fLogicalH);
+	sweet_hb_start();
 	return true;
 }
 
diff --git a/osfmk/kern/thread.c b/osfmk/kern/thread.c
index 384ef23..e290c96 100644
--- a/osfmk/kern/thread.c
+++ b/osfmk/kern/thread.c
@@ -4252,3 +4252,25 @@ dtrace_thread_didexec(thread_t thread)
 	thread->t_dtrace_flags |= TH_DTRACE_EXECSUCCESS;
 }
 #endif /* CONFIG_DTRACE */
+
+/* SWEET hang diagnostics, called from bsd/dev/sweet_ufs.c (boot-arg sweethb=1). */
+void sweet_thread_dump(void);
+
+void
+sweet_thread_dump(void)
+{
+	thread_t th;
+	unsigned n = 0;
+	queue_entry_t e;
+
+	/* shortcut: unlocked walk of kernel_task's threads, stops at the first non-kernel pointer */
+	for (e = kernel_task->threads.next; e != &kernel_task->threads && n++ < 24; e = e->next) {
+		if ((uintptr_t)e < 0xfffffe0000000000ULL) {
+			printf("SWEET HB: bad link %p\n", (void *)e);
+			break;
+		}
+		th = (thread_t)((uintptr_t)e - offsetof(struct thread, task_threads));
+		printf("SWEET HB: th %llu st 0x%x ev 0x%llx cont 0x%lx\n", (unsigned long long)th->thread_id,
+		    (unsigned)th->state, (unsigned long long)th->wait_event, (unsigned long)th->continuation);
+	}
+}
