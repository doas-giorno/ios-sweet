diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 670a4d1..9fa08da 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -1168,4 +1168,64 @@ sweet_ufs_rootdev(dev_t *dev)
 	*dev = su.bdev;
 	return 0;
 }
+/*
+ * Hang diagnostics (boot-arg sweethb=1): a heartbeat thread started by AppleCLCD that prints
+ * a line every second and, at ticks 5 and 12, every thread's state and wait event (raw
+ * kernel addresses plus the kernel slide: symbolise offline with the unstripped kernel).
+ * No heartbeat = no scheduling/timer interrupts; heartbeat but no progress = see the dump.
+ */
+#include <kern/thread.h>
+#include <kern/queue.h>
+extern queue_head_t threads;
+extern lck_mtx_t tasks_threads_lock;
+extern vm_offset_t vm_kernel_slide;
+
+static void
+sweet_hb_dump(void)
+{
+	thread_t th;
+	unsigned n = 0;
+
+	printf("SWEET HB: slide 0x%lx\n", (unsigned long)vm_kernel_slide);
+	lck_mtx_lock(&tasks_threads_lock);
+	qe_foreach_element(th, &threads, threads) {
+		if (n++ >= 24) {
+			break;
+		}
+		printf("SWEET HB: th %llu st 0x%x ev 0x%llx cont 0x%lx\n", (unsigned long long)th->thread_id,
+		    (unsigned)th->state, (unsigned long long)th->wait_event, (unsigned long)th->continuation);
+	}
+	lck_mtx_unlock(&tasks_threads_lock);
+}
+
+static void
+sweet_hb_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t sec;
+	nanoseconds_to_absolutetime(NSEC_PER_SEC, &sec);
+	for (uint32_t n = 1;; n++) {
+		uint64_t until = mach_absolute_time() + sec;
+		while (mach_absolute_time() < until) {
+		}
+		printf("SWEET HB %u: t=%llu\n", n, mach_absolute_time());
+		if (n == 5 || n == 12) {
+			sweet_hb_dump();
+		}
+	}
+}
+
+void sweet_hb_start(void);
+
+void
+sweet_hb_start(void)
+{
+	uint32_t on = 0;
+	thread_t thread;
+
+	PE_parse_boot_argn("sweethb", &on, sizeof(on));
+	if (on && kernel_thread_start(sweet_hb_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
 #endif /* ARM64_BOARD_CONFIG_SWEET */
